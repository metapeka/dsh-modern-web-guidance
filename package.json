{
  "name": "dsh-modern-web-guidance",
  "version": "0.8.2",
  "description": "Modern web platform guidance for DeepSeek Harness agents: Google Chrome's 208-guide catalog with offline search and retrieve tools, a report-only legacy-pattern scanner, plus a Chrome extensions (MV3) skill.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "data",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.ru.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE",
    "icon.svg",
    "icon.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots",
        "locale",
        "remote"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "web",
    "guidance",
    "chrome",
    "css",
    "html",
    "accessibility",
    "best-practices",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metapeka/dsh-modern-web-guidance.git"
  },
  "bugs": {
    "url": "https://github.com/metapeka/dsh-modern-web-guidance/issues"
  },
  "homepage": "https://github.com/metapeka/dsh-modern-web-guidance#readme",
  "icon": "icon.svg",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  }
}
